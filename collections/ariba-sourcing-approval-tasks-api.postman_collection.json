          "request": {
            "name": "Ariba Sourcing List Changed Approval Tasks",
            "description": {
              "content": "Returns a list of external approval tasks that have changed state. Activities that change the state of a task include submitting the task or completing the approval flow. Rate limited to 20 req/sec, 400 req/min, 12000 req/hour, 40000 req/day.",
