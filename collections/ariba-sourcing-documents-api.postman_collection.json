            },
            "url": {
              "path": [
                ":entity_type",
                ":entity_id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "realm",
                  "value": "<string>",
                  "description": "(Required) The SAP Ariba realm name."
                },
                {
                  "disabled": false,
                  "key": "$select",
                  "value": "<string>",
                  "description": "For sourcing events, specifies which parts of the event to retrieve (e.g., line items, invited suppliers)."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "entity_type",
                  "description": "(Required) Type of item to be approved. Examples: Workspace, RFXDocument, ContractWorkspace, Folder."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "entity_id",
                  "description": "(Required) The ID of the item to be approved."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
